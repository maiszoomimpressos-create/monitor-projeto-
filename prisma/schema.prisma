// Banco de controle (control-plane) do monitor de disponibilidade.
// Este banco é separado dos projetos Supabase monitorados.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  // Conexão direta (sem pgbouncer) usada só pelo Prisma Migrate — necessária
  // para advisory locks durante migrations em bancos com connection pooling (Neon).
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum CheckStatus {
  SUCESSO
  FALHA_CONEXAO
  FALHA_AUTENTICACAO
  FALHA_CONFIGURACAO
  POSSIVEL_PAUSA
  ERRO_DESCONHECIDO
}

enum ProjectType {
  SUPABASE // leitura leve via PostgREST (tabela de verificação + chave anon)
  HTTP     // GET/HEAD em uma URL pública (site/app em plano gratuito)
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique // sempre minúsculo
  passwordHash String    // scrypt (formato: scrypt$N$r$p$salt$hash)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  projects     Project[]

  @@map("users")
}

model Project {
  id                String   @id @default(cuid())
  // Dono do projeto. Opcional apenas para não quebrar projetos criados antes do
  // multiusuário; projetos sem dono não aparecem para nenhum usuário.
  ownerId           String?
  owner             User?    @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name              String
  type              ProjectType @default(SUPABASE)
  // E-mail da conta (Supabase/hospedagem) onde o projeto foi criado. Só referência; nunca usado para acesso.
  accountEmail      String?
  // URL do projeto: base *.supabase.co (SUPABASE) ou URL completa https (HTTP).
  // Nome mantido por compatibilidade com o banco existente.
  supabaseUrl       String
  // Só para HTTP: método (GET | HEAD) e status esperado (null = qualquer 2xx/3xx).
  httpMethod        String   @default("GET")
  expectedStatus    Int?
  // Nome da tabela de verificação na API REST (PostgREST), ex: "_uptime_healthcheck"
  healthcheckTable  String   @default("_uptime_healthcheck")

  // Credencial (chave anon/restrita) criptografada em repouso (AES-256-GCM).
  // A chave de criptografia (ENCRYPTION_KEY) NUNCA fica no banco.
  // Vazios ("") em projetos HTTP, que não usam credencial.
  encryptedKey      String
  keyLastFour       String // últimos caracteres da chave, apenas para exibição/identificação

  intervalMinutes   Int      @default(360) // 6 horas
  enabled           Boolean  @default(true)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Controle de concorrência / agendamento
  lastRunAt         DateTime?
  lastSuccessAt     DateTime?
  isRunning         Boolean  @default(false)
  runningSince      DateTime?

  // Consecutivas falhas de conexão, usado para inferir "possível pausa"
  consecutiveConnFailures Int @default(0)

  executions        Execution[]

  @@index([ownerId])
  @@map("projects")
}

model Execution {
  id              String      @id @default(cuid())
  projectId       String
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  startedAt       DateTime    @default(now())
  finishedAt      DateTime?
  durationMs      Int?

  status          CheckStatus
  httpStatus      Int?
  message         String?     // mensagem compreensível, sem dados sensíveis

  triggeredBy     String      @default("cron") // "cron" | "manual"

  @@index([projectId, startedAt])
  @@map("executions")
}
