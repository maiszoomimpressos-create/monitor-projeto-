# =============================================================================
# Banco de controle (control-plane) — armazena cadastro dos projetos e histórico.
# NÃO é um projeto Supabase monitorado; recomenda-se um Postgres via Vercel
# Marketplace (ex.: Neon) ou outro Postgres gerenciado.
# =============================================================================
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"
# Se o provedor usar connection pooling (ex.: Neon), defina também a conexão
# direta (sem pgbouncer) usada apenas pelo Prisma Migrate:
DATABASE_URL_UNPOOLED="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# =============================================================================
# Segredo usado pelo Vercel Cron Jobs para autorizar a execução do agendamento.
# Gere com: openssl rand -hex 32
# No Vercel, configure a mesma variável em Project Settings > Environment
# Variables — se usar o nome exato CRON_SECRET, o Vercel já envia
# automaticamente "Authorization: Bearer <CRON_SECRET>" nas chamadas de cron.
# =============================================================================
CRON_SECRET="gere-um-valor-aleatorio-longo"

# =============================================================================
# Sessão dos usuários (login/cadastro por e-mail e senha).
# ADMIN_PASSWORD não é mais usada desde o multiusuário (ver DECISIONS.md D-005).
# Segredo usado para assinar o cookie de sessão (HMAC).
# Gere com: openssl rand -hex 32
ADMIN_SESSION_SECRET="gere-um-valor-aleatorio-longo"

# =============================================================================
# Chave de criptografia (AES-256-GCM) usada para proteger as credenciais dos
# projetos Supabase cadastrados antes de salvá-las no banco de controle.
# Deve decodificar para exatamente 32 bytes em base64.
# Gere com: openssl rand -base64 32
# NUNCA reutilize esta chave em outro ambiente e nunca a versione no git.
# =============================================================================
ENCRYPTION_KEY="gere-32-bytes-em-base64"

# =============================================================================
# Agendador (ver src/lib/schedule.ts e DECISIONS.md D-006).
# Período, em minutos, de quem chama /api/cron/check-projects. Padrão 1440
# (Vercel Hobby, cron diário). Com agendador externo a cada 15 min, use 15.
# =============================================================================
SCHEDULER_TICK_MINUTES="1440"
# Minuto do dia (UTC) em que os disparos se alinham. 540 = 09:00 UTC (cron da Vercel).
# Com agendador externo a cada 15 min, use 0.
SCHEDULER_TICK_OFFSET_MINUTES="540"

# =============================================================================
# Agendador próprio (worker, docs/agendador-proprio.md, D-007). Com o worker ativo,
# use SCHEDULER_TICK_MINUTES="1" e SCHEDULER_TICK_OFFSET_MINUTES="0" no worker E na Vercel.
# =============================================================================
WORKER_TICK_SECONDS="60"
WORKER_SWEEP_BUDGET_SECONDS="300"
# PORT="8080"   # opcional: health check HTTP do worker
